// Firestore security rules for this app's Fleet Sync feature (web/fleet-sync.ts).
//
// NOTHING NEEDS PUBLISHING FOR THIS APP. This file is a copy of what is
// already live on the `dropfleet-builder` project, kept here so the rules
// this app depends on are reviewable and restorable from this repo too. Read
// it; do not paste it anywhere unless the live ruleset has been lost.
//
// This app reuses the `dropfleet-builder` Firebase project (same author, same
// free Firestore instance) rather than standing up a second one, and shares
// Dropfleet Commander's `sync` collection, writing document ids prefixed
// `abs2-`.
//
// It used to have a collection of its own, `abs-sync`, which is tidier and
// did not work. Firestore has ONE published ruleset per project; the live one
// is Dropfleet Commander's and it has never mentioned `abs-sync`, so every
// read and write from this app came back 403 and Fleet Sync was dead for
// everyone who turned it on. The fix that arrangement needed was a person
// hand-merging two rules files in the Firebase console, and re-merging them
// whenever either app changed - a manual step whose failure mode is a silent
// 403 in the other app. It had already failed once.
//
// Sharing the collection deletes that step. The `/sync/{token}` block below
// is live today and allows any id of 24-200 characters, so `abs2-`-prefixed
// ids are covered by rules that stay published for as long as Dropfleet's own
// sync works. The two apps cannot collide: Dropfleet normalises its tokens to
// letters and hyphens only, so no Dropfleet id can ever contain the "2".
//
// The model is "the token IS the key" (a capability, not an account). There
// is no Firebase Auth here on purpose: a user's Sync Token is a six-word
// phrase that (with the prefix) doubles as the document id. Knowing it grants
// read and write to that one document and nothing else.
//
// The single most important line below is `allow list: if false`. Without it,
// anyone could ask Firestore to enumerate /sync and walk every user's fleets,
// from either app, without guessing a single token. Denying `list` means a
// token can only be fetched by naming it exactly - and it is also what keeps
// the two apps' documents invisible to each other despite sharing a
// collection.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared by Dropfleet Commander (bare six-word ids) and this app
    // (`abs2-` + six words). Keep this block's shape identical to Dropfleet
    // Commander's firestore.rules; if that file changes, mirror the change
    // here too, and check the change does not narrow what an `abs2-` id is
    // allowed to do.
    match /sync/{token} {
      // Length floor: blocks probing for short/obvious ids like "test" or "a".
      // Six hyphenated words always clear this comfortably.
      function sane() {
        return token.size() >= 24 && token.size() <= 200;
      }

      allow get: if sane();

      // The whole list registry travels as one JSON string, so the schema
      // check is exact: three known fields, nothing else. The size cap keeps
      // a single token from being used as free unlimited storage (Firestore's
      // own hard limit is 1 MiB per document).
      allow create, update: if sane()
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt', 'version'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 900000
        && request.resource.data.updatedAt is int
        && request.resource.data.version is int;

      // Deleting is allowed to whoever holds the token, because it has to be:
      // without it a user could never remove their fleets from the cloud,
      // only stop syncing locally. It costs nothing extra in security terms,
      // since anyone who can reach this document can already overwrite its
      // payload.
      allow delete: if sane();

      // Enumeration stays off. This is the line that matters.
      allow list: if false;
    }

    // Everything outside /sync stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
